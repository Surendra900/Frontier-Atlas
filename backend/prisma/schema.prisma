generator client {
  provider = "prisma-client-js"
}

generator client_cloudflare {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  runtime  = "cloudflare"
}

datasource db {
  provider = "postgresql"
}

model Paper {
  id                     String            @id @default(uuid())
  slug                   String            @unique
  title                  String
  shortTitle             String?           @map("short_title")
  abstract               String?
  tlDr                   String?           @map("tl_dr")
  publicationDate        DateTime?         @map("publication_date")
  submissionDate         DateTime?         @map("submission_date")
  arxivId                String?           @unique @map("arxiv_id")
  doi                    String?
  paperUrl               String?           @map("paper_url")
  pdfUrl                 String?           @map("pdf_url")
  thumbnailUrl           String?           @map("thumbnail_url")
  sourceUrl              String?           @map("source_url")
  projectUrl             String?           @map("project_url")
  citationCount          Int               @default(0) @map("citation_count")
  referenceCount         Int               @default(0) @map("reference_count")
  pageCount              Int?              @map("page_count")
  paperType              String?           @map("paper_type")
  status                 String?
  language               String?
  license                String?
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime?         @updatedAt @map("updated_at")
  githubForks            Int?              @default(0) @map("github_forks")
  githubStars            Int?              @default(0) @map("github_stars")
  githubUrl              String?           @map("github_url")
  isOfficialCode         Boolean?          @default(false) @map("is_official_code")
  hfUpvotes              Int?              @default(0) @map("hf_upvotes")
  trendingScore          Float?            @default(0) @map("trending_score")
  discoverySource        String?           @map("discovery_source")
  authors                String?
  domain                 String?
  task                   String?
  huggingface_url        String?
  hf_model_url           String?
  hfUrl                  String?           @map("hf_url")
  importance_score       Float?            @default(0.0)
  venue                  String?
  organization           String?
  github_hourly_increase Float?            @default(1.0)
  conferences            PaperConference[]
  datasets               PaperDataset[]
  journals               PaperJournal[]
  labs                   PaperLab[]
  methods                PaperMethod[]
  models                 PaperModel[]
  repositories           PaperRepository[]
  tasks                  PaperTask[]
  universities           PaperUniversity[]
  rankings               Ranking[]
  sotaClaims             SotaClaim[]
  summaries              Summary[]
  savedPapers      SavedPaper[]

  @@map("papers")
}

model EntityRelationship {
  id               String @id @default(uuid())
  sourceEntityType String @map("source_entity_type")
  sourceEntityId   String @map("source_entity_id")
  targetEntityType String @map("target_entity_type")
  targetEntityId   String @map("target_entity_id")
  relationshipType String @map("relationship_type")
  weight           Float  @default(1.0)
  metadataJson     Json?  @map("metadata_json")

  @@unique([sourceEntityId, targetEntityId, relationshipType])
  @@index([sourceEntityType, sourceEntityId])
  @@index([targetEntityType, targetEntityId])
  @@map("entity_relationships")
}

model Startup {
  id            String    @id @default(uuid())
  canonicalName String    @unique @map("canonical_name")
  sourceName    String?   @map("source_name")
  sourceUrl     String?   @map("source_url")
  employeeCount Int?      @map("employee_count")
  collectedAt   DateTime  @default(now()) @map("collected_at")
  createdAt     DateTime? @default(now()) @db.Timestamp(6)
  updatedAt     DateTime? @default(now()) @db.Timestamp(6)

  @@map("startups")
}

model Task {
  id        String      @id @default(uuid())
  name      String      @unique
  slug      String      @unique
  color     String?
  domain    String?
  createdAt DateTime?   @db.Timestamp(6)
  updatedAt DateTime?   @updatedAt @db.Timestamp(6)
  papers    PaperTask[]

  @@map("tasks")
}

model PaperTask {
  paper_id String
  task_id  String
  paper    Paper  @relation(fields: [paper_id], references: [id])
  task     Task   @relation(fields: [task_id], references: [id])

  @@id([paper_id, task_id])
  @@map("paper_tasks")
}

model Method {
  id          String        @id @default(uuid())
  name        String        @unique
  slug        String        @unique
  category    String?
  description String?
  createdAt   DateTime?     @db.Timestamp(6)
  updatedAt   DateTime?     @db.Timestamp(6)
  papers      PaperMethod[]

  @@map("methods")
}

model PaperMethod {
  paper_id  String
  method_id String
  method    Method @relation(fields: [method_id], references: [id])
  paper     Paper  @relation(fields: [paper_id], references: [id])

  @@id([paper_id, method_id])
  @@map("paper_methods")
}

model Benchmark {
  id                String      @id @default(uuid())
  name              String      @unique
  slug              String      @unique
  description       String?
  domain            String?
  task              String?
  metric            String?
  year              Int?
  papers_evaluated  Int?
  is_popular        Boolean?
  is_trending       Boolean?
  is_recently_added Boolean?
  createdAt         DateTime?   @db.Timestamp(6)
  updatedAt         DateTime?   @db.Timestamp(6)
  category          String?
  status            String?
  results_count     Int?
  models_count      Int?
  paper_title       String?
  paper_url         String?
  repo_url          String?
  dataset_url       String?
  top_models        String[]
  modality          String?
  benchmark_url     String?
  rankings          Ranking[]
  claims            SotaClaim[]

  @@map("benchmarks")
}

model SotaClaim {
  id           String    @id @default(uuid())
  paper_id     String
  benchmark_id String
  benchmark    Benchmark @relation(fields: [benchmark_id], references: [id])
  paper        Paper     @relation(fields: [paper_id], references: [id])

  @@unique([paper_id, benchmark_id])
  @@map("sota_claims")
}

model Ranking {
  id            String    @id @default(uuid())
  paper_id      String
  benchmark_id  String
  rank          Int?
  previous_rank Int?
  score         Float?
  score_str     String?
  model_name    String?
  metric        String?
  updated_at    DateTime  @updatedAt
  url           String?
  source        String?
  model_id      String?
  organization  String?
  verified      Boolean?
  updatedAt     DateTime? @default(now()) @db.Timestamp(6)
  resultDate    DateTime? @default(now()) @db.Timestamp(6)
  previousRank  Int?
  sourceUrl     String?   @default("https://paperswithcode.com/sota")
  result_date   DateTime? @db.Timestamp(6)
  source_url    String?
  benchmark     Benchmark @relation(fields: [benchmark_id], references: [id])
  paper         Paper     @relation(fields: [paper_id], references: [id])

  @@unique([paper_id, benchmark_id])
  @@index([benchmark_id, rank])
  @@map("rankings")
}

model Model {
  id              String       @id @default(uuid())
  name            String
  slug            String       @unique
  vendor          String?
  vendor_logo_url String?
  description     String?
  parameter_count String?
  modality        String?
  access_type     String?
  openness_type   String?
  release_date    DateTime?
  benchmark_score Json?
  model_family    String?
  category        String?
  capabilities    Json?
  research_areas  Json?
  architecture    String?
  context_window  String?
  license         String?
  model_versions  Json?
  release_notes   String?
  paper_url       String?
  repository_url  String?
  api_url         String?
  created_at      DateTime     @default(now())
  updated_at      DateTime
  createdAt       DateTime?    @default(now()) @db.Timestamp(6)
  updatedAt       DateTime?    @default(now()) @updatedAt @db.Timestamp(6)
  releaseDate     DateTime?    @default(now()) @db.Timestamp(6)
  parameterCount  String?      @default("100B+")
  accessType      String?      @default("Open / API")
  opennessType    String?      @default("Commercial / Permissive")
  benchmarkScore  Json?        @default("{}")
  modelFamily     String?
  trendingScore   Float?       @default(0)
  paperUrl        String?
  repositoryUrl   String?
  apiUrl          String?
  contextWindow   String?
  researchAreas   Json?
  modelVersions   Json?
  releaseNotes    String?
  role            String?
  papers          PaperModel[]

  @@map("models")
}

model PaperModel {
  paper_id String
  model_id String
  role     String? @default("referenced")
  model    Model   @relation(fields: [model_id], references: [id], onDelete: Cascade)
  paper    Paper   @relation(fields: [paper_id], references: [id], onDelete: Cascade)

  @@id([paper_id, model_id])
  @@map("paper_models")
}

model Dataset {
  id         String         @id @default(uuid())
  name       String
  slug       String         @unique
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  created_at DateTime?      @default(now()) @db.Timestamp(6)
  updated_at DateTime?      @default(now()) @db.Timestamp(6)
  papers     PaperDataset[]

  @@map("datasets")
}

model PaperDataset {
  paper_id   String
  dataset_id String
  dataset    Dataset @relation(fields: [dataset_id], references: [id], onDelete: Cascade)
  paper      Paper   @relation(fields: [paper_id], references: [id], onDelete: Cascade)

  @@id([paper_id, dataset_id])
  @@map("paper_datasets")
}

model Lab {
  id         String     @id @default(uuid())
  name       String
  slug       String     @unique
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  created_at DateTime?  @default(now()) @db.Timestamp(6)
  updated_at DateTime?  @default(now()) @db.Timestamp(6)
  papers     PaperLab[]

  @@map("labs")
}

model PaperLab {
  paper_id String
  lab_id   String
  lab      Lab    @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  paper    Paper  @relation(fields: [paper_id], references: [id], onDelete: Cascade)

  @@id([paper_id, lab_id])
  @@map("paper_labs")
}

model University {
  id         String            @id @default(uuid())
  name       String
  slug       String            @unique
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  created_at DateTime?         @default(now()) @db.Timestamp(6)
  updated_at DateTime?         @default(now()) @db.Timestamp(6)
  papers     PaperUniversity[]

  @@map("universities")
}

model PaperUniversity {
  paper_id      String
  university_id String
  paper         Paper      @relation(fields: [paper_id], references: [id], onDelete: Cascade)
  university    University @relation(fields: [university_id], references: [id], onDelete: Cascade)

  @@id([paper_id, university_id])
  @@map("paper_universities")
}

model Conference {
  id         String            @id @default(uuid())
  name       String
  slug       String            @unique
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  created_at DateTime?         @default(now()) @db.Timestamp(6)
  updated_at DateTime?         @default(now()) @db.Timestamp(6)
  papers     PaperConference[]

  @@map("conferences")
}

model PaperConference {
  paper_id      String
  conference_id String
  conference    Conference @relation(fields: [conference_id], references: [id], onDelete: Cascade)
  paper         Paper      @relation(fields: [paper_id], references: [id], onDelete: Cascade)

  @@id([paper_id, conference_id])
  @@map("paper_conferences")
}

model Journal {
  id         String         @id @default(uuid())
  name       String
  slug       String         @unique
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  created_at DateTime?      @default(now()) @db.Timestamp(6)
  updated_at DateTime?      @default(now()) @db.Timestamp(6)
  papers     PaperJournal[]

  @@map("journals")
}

model PaperJournal {
  paper_id   String
  journal_id String
  journal    Journal @relation(fields: [journal_id], references: [id], onDelete: Cascade)
  paper      Paper   @relation(fields: [paper_id], references: [id], onDelete: Cascade)

  @@id([paper_id, journal_id])
  @@map("paper_journals")
}

model Repository {
  id         String            @id @default(uuid())
  url        String            @unique
  name       String
  owner      String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  created_at DateTime?         @default(now()) @db.Timestamp(6)
  updated_at DateTime?         @default(now()) @db.Timestamp(6)
  papers     PaperRepository[]

  @@map("repositories")
}

model PaperRepository {
  paper_id      String
  repository_id String
  paper         Paper      @relation(fields: [paper_id], references: [id], onDelete: Cascade)
  repository    Repository @relation(fields: [repository_id], references: [id], onDelete: Cascade)

  @@id([paper_id, repository_id])
  @@map("paper_repositories")
}

model User {
  id               String         @id @default(uuid())
  username         String         @unique
  email            String         @unique
  password         String
  displayName      String
  avatar           String?
  bio              String?
  github           String?
  twitter          String?
  website          String?
  reputationScore  Int            @default(0)
  auth_id          String?        @unique
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  linkedin         String?
  display_name     String?
  reputation_score Int?           @default(0)
  created_at       DateTime?      @default(now()) @db.Timestamp(6)
  updated_at       DateTime?      @default(now()) @db.Timestamp(6)
  refresh_tokens   RefreshToken[]
  summaries        Summary[]
  savedPapers      SavedPaper[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  token      String    @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  user_id    String?
  expires_at DateTime? @db.Timestamp(6)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  users      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Summary {
  id         String    @id @default(uuid())
  content    String
  paper_id   String
  user_id    String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
  paper      Paper     @relation(fields: [paper_id], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("summaries")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model benchmarks_import {
  id                String?
  name              String?
  slug              String?
  createdat         DateTime? @db.Timestamp(6)
  updatedat         DateTime? @db.Timestamp(6)
  description       String?
  domain            String?
  task              String?
  category          String?
  metric            String?
  status            String?
  year              Int?
  results_count     Int?
  models_count      Int?
  top_models        String[]
  paper_title       String?
  paper_url         String?
  repo_url          String?
  dataset_url       String?
  is_popular        Boolean?
  is_trending       Boolean?
  is_recently_added Boolean?
  modality          String?
  benchmark_url     String?
  aliases           String[]

  @@ignore
}

model SavedPaper {
  paper_id   String
  user_id    String
  created_at DateTime? @default(now()) @db.Timestamp(6)

  paper      Paper     @relation(fields: [paper_id], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, paper_id])
  @@map("saved_papers")
}