# FrontierAtlas Backend — Environment Variables
# Copy to .env for local development. Never commit real credentials.

# Database (required)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Authentication
JWT_ACCESS_SECRET="your-access-secret-here"
JWT_REFRESH_SECRET="your-refresh-secret-here"
OAUTH_STATE_SECRET="your-oauth-state-secret-here"

# Query Router
# QUERY_TIMEOUT_MS=30000

# Redis Cache (optional)
# UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# OAuth Providers (optional for social login)
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"
# GITHUB_CLIENT_ID="your-github-client-id"
# GITHUB_CLIENT_SECRET="your-github-client-secret"

# Daily Sync
SYNC_LOOKBACK_HOURS=24
SYNC_BATCH_SIZE=100

# HTTP Client
HTTP_MAX_RETRIES=3
HTTP_TIMEOUT_MS=10000
HTTP_INITIAL_RETRY_DELAY_MS=1000

# Optional
# HUGGINGFACE_API_KEY=hf_xxxxxxxxxx

# Security
# OAuth callbacks use a dedicated short-lived signed state plus a nonce cookie.
# Never commit real database URLs, JWT secrets, OAuth client secrets, or API tokens.
